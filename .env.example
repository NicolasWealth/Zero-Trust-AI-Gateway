# Copy to .env and fill in. Never commit .env.
PORT=3000
# true = do not call OpenAI. Default is true.
DEMO_MODE=true
# Only used when DEMO_MODE=false
OPENAI_API_KEY=
# Supabase project (audit log). Service key is server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Set true only behind a reverse proxy you control (Vercel is detected automatically)
TRUST_PROXY=false
